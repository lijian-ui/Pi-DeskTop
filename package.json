{
  "name": "pi-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Desktop shell for Pi AI coding agent",
  "author": "lijian-ui",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "build:electron": "npm run build && tsc -p tsconfig.node.json && node scripts/build-electron.mjs",
    "publish": "node scripts/publish.mjs",
    "publish:gitee": "node scripts/publish-gitee.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@lobehub/icons": "^5.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.19.0",
    "dingtalk-stream": "^2.1.5",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "form-data": "^4.0.6",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.16.0",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "react-markdown": "^9.0.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
